# =============================================================================
# SafeSpeak — Git Ignore Configuration
# =============================================================================

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ── Environment Variables & Secrets (CRITICAL) ────────────────────────────────
.env
.env.*
*.env
*.env.*
*.key
*.pem
*.crt
*.pfx
*.p12

# ── Cloud & Firebase Credentials (CRITICAL) ───────────────────────────────────
*firebase-credentials*.json
*serviceAccountKey*.json
*-adminsdk-*.json
firebase-credentials.json
backend/firebase/firebase-credentials.json

# ── Python Bytecode & Cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Database & Storage ────────────────────────────────────────────────────────
db.sqlite3
*.sqlite3
*.db
staticfiles/
media/

# ── Application Logs & Temporary Dumps ────────────────────────────────────────
*.log
logs/
*.tmp
*.bak

# ── IDE & Operating System Artifacts ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

